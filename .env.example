# GitHub OAuth App credentials (Settings > Developer settings > OAuth Apps)
# Authorization callback URL must be: https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployed site (placeholder — replace with your real domain)
NEXTAUTH_URL=https://commitmuseum.example.com

# Required when running behind a reverse proxy (e.g. host Nginx terminating
# TLS and forwarding to the app container over plain HTTP) — without this,
# Auth.js rejects every request with "UntrustedHost" since the Host header
# it sees doesn't match NEXTAUTH_URL's scheme.
AUTH_TRUST_HOST=true

# Data-fetching limits (kept small to stay within GitHub API rate limits,
# since nothing is cached to disk/DB — every dashboard load refetches live)
MAX_REPOS_TO_SCAN=15
MAX_COMMITS_PER_REPO=200
GITHUB_API_CONCURRENCY=5

# Whether to include private repos in the scan. Requires the GitHub OAuth App
# to request the "repo" scope (broad read/write access to private code) and
# the user to re-consent. Off by default — keep false unless you understand
# the trade-off.
INCLUDE_PRIVATE_REPOS=false
